# Copy to .env and fill in the secrets before running `docker compose up`.

# Port the site is published on (http://localhost:8080).
HTTP_PORT=8080

# PostgreSQL credentials. Use a long random password.
POSTGRES_DB=chirp
POSTGRES_USER=chirp
POSTGRES_PASSWORD=change-me

# Signs session cookies. At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Set to true when the site is served over HTTPS (it should be in production).
COOKIE_SECURE=false

# Set to true only if another reverse proxy (TLS terminator, load balancer) sits in front.
TRUST_PROXY=false

MAX_UPLOAD_MB=5
WEB_CONCURRENCY=2
